# Placeholders only. Copy to .env and fill in real values. Never commit .env.
# On Render the same names are entered in the dashboard (see render.yaml and docs/RENDER.md).
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-long-random-value
PLATFORM_DOMAIN=localhost
PLATFORM_HOSTS=localhost
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Neon PostgreSQL: the pooled URL serves the app, the direct (non-pooled) URL is used automatically by `migrate`
DATABASE_URL=postgresql://USER:PASSWORD@POOLER-HOST/DBNAME?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DB_CONN_MAX_AGE=60

# Redis: required in production. Local development ignores it unless DEV_USE_REDIS=1
REDIS_URL=redis://localhost:6379/0

# Brevo (real email) and the sender address you verified in Brevo
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NTS Restaurant Platform

# Monime (real payments). MONIME_WEBHOOK_SECRET is the 32-100 character secret of the webhook you create in the Monime dashboard
PAYMENT_PROVIDER=monime
MONIME_API_KEY=
MONIME_SPACE_ID=
MONIME_WEBHOOK_SECRET=

# Cloudinary (all uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Cloudflare R2 (backups) and the key that encrypts them: `python manage.py generate_backup_key`
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BACKUP_ENCRYPTION_KEY=

# Security (production defaults are enforced by config/settings/prod.py)
MFA_ENFORCEMENT=true
UPLOAD_SCANNER=clamav
CLAMAV_HOST=
CLAMAV_PORT=3310
UPLOAD_SCAN_FAIL_CLOSED=true

GOOGLE_OAUTH_CLIENT_ID=
PUBLIC_URL_SCHEME=http
TERMS_VERSION=2026-11-01
PRIVACY_VERSION=2026-11-01
VERIFICATION_CODE_TTL_SECONDS=600
